<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="form-container container">
  <div class="form-card card-glass">
    <div class="form-header">
      <h2>Create New Task</h2>
      <p>Add an assignment or study objective to track.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/tasks/add" method="POST" class="main-form">
      <div class="form-group">
        <label for="title">Task Title <span class="required">*</span></label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          class="form-control" 
          placeholder="e.g. Physics Lab Report" 
          value="<%= title %>"
          required 
          autofocus 
        />
      </div>

      <div class="form-group">
        <label for="dueDate">Due Date <span class="required">*</span></label>
        <input 
          type="date" 
          id="dueDate" 
          name="dueDate" 
          class="form-control" 
          value="<%= dueDate %>" 
          required 
        />
      </div>

      <div class="form-group">
        <label for="description">Description / Notes</label>
        <textarea 
          id="description" 
          name="description" 
          rows="4" 
          class="form-control" 
          placeholder="Add assignment requirements, submission link, or notes..."
        ><%= description %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-cta">
          <i class="fa-solid fa-check"></i> Save Task
        </button>
        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
